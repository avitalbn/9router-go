<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.avitalbn.9router-fleet</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USER/.local/share/9router-go-fleet/bootstrap/9router-fleet</string>
    <string>launch</string>
    <string>--config</string>
    <string>/Users/YOUR_USER/.local/share/9router-go-fleet/device.json</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/YOUR_USER/.local/share/9router-go-fleet/supervisor.log</string>
  <key>StandardErrorPath</key><string>/Users/YOUR_USER/.local/share/9router-go-fleet/supervisor.log</string>
</dict>
</plist>
